<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dybw-agent as a LaunchAgent: started at login inside the GUI (Aqua) session, so its pinentry-mac and Touch ID
  prompts show for callers with no terminal (hotkeys, launchers). dybw still starts the agent on demand when none
  runs; the two never fight: the second agent finds the lock held and exits 1, which launchd does not retry.

  Install: replace @HOME@ with your home and @TMPDIR@ with `getconf DARWIN_USER_TEMP_DIR` (the TMPDIR of your
  shells: dybw finds the agent's socket in $TMPDIR/dybw-<uid>, so both must agree), then
    cp org.dybw.agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.dybw.agent.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.dybw.agent</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Next to dybw: dybw starts the agent beside itself, and the agent trusts the dybw beside it. -->
    <string>@HOME@/.cargo/bin/dybw-agent</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TMPDIR</key>
    <string>@TMPDIR@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash only: `dybw agent stop` (exit 0) stays stopped until the next dybw call or login. -->
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <!-- Metadata only (profiles, ops, decisions), never a value. -->
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/dybw-agent.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/dybw-agent.log</string>
</dict>
</plist>
